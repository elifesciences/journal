{% if criticalCss is not defined %}
{% set criticalCss = 'institution-eligibility' %}
{% endif %}

{% extends '::page.html.twig' %}

{% block title %}Check your institution's eligibility{% endblock %}

{% block body %}

    <div class="wrapper wrapper--eligibility-tool">
        <div class="institution-eligibility-page">
          {{ render_pattern(contentHeader) }}

          {% include 'calls-to-action.html.twig' %}

            {% block main %}

              {% if checker ?? false %}

                {{ render_pattern(checker) }}

              {% endif %}

              {% if outcome ?? false %}

                {{ render_pattern(outcome) }}

              {% endif %}

                {% if linkCardCollection %}

                    <div class="eligibility_tool_for_more_information">
                        For more information:
                    </div>

                    {{ render_pattern(linkCardCollection) }}

                {% endif %}

            {% endblock %}
      </div>
    </div>

{% endblock %}