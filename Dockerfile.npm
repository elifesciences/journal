ARG node_version
FROM node:${node_version} as npm

RUN apt-get update && apt-get install --no-install-recommends -y \
    nasm \
    libvips-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Fix for ARM64
ENV CFLAGS="-DPNG_ARM_NEON_OPT=0"
# puppeteer's own bundled Chromium download is x86-64 only, which needs emulation on
# non-amd64 hosts and can fail there. critical_css installs a native `chromium` package
# instead (see Dockerfile.critical_css) and points PUPPETEER_EXECUTABLE_PATH at it, so
# there's no need to download puppeteer's own copy here at all.
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
COPY npm-shrinkwrap.json \
    package.json \
    /app/
RUN npm install
