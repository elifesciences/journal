{
    "name": "elife/journal",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "eLife\\Journal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "test\\eLife\\Journal\\": "test/"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-redis": "*",
        "babdev/pagerfanta-bundle": "^4.6.0",
        "beberlei/assert": "^v3.3.4",
        "cocur/slugify": "^4.7.0",
        "composer/package-versions-deprecated": "1.11.99.2",
        "cweagans/composer-patches": "^1.6",
        "elife/api-client": "dev-symfony-7",
        "elife/api-sdk": "dev-symfony-7",
        "elife/patterns": "dev-upgrade-patterns-to-php-8.3",
        "fig/link-util": "^1.0",
        "firebase/php-jwt": "^7.0",
        "google/apiclient": "^2.19",
        "guzzlehttp/guzzle": "^7.15",
        "guzzlehttp/promises": "^2.0",
        "guzzlehttp/psr7": "^2.7",
        "knpuniversity/oauth2-client-bundle": "^2.20.0",
        "league/oauth2-client": "^2.2",
        "mindplay/composer-locator": "^2.1",
        "monolog/monolog": "^3.0",
        "mustache/mustache": "^2.12",
        "nelmio/security-bundle": "^3.9",
        "pagerfanta/pagerfanta": "^1.0",
        "psr/http-message": "^1.0",
        "psr/log": "^3.0",
        "symfony/asset": "^7.4",
        "symfony/browser-kit": "^7.4",
        "symfony/config": "^7.0",
        "symfony/console": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/debug-bundle": "^7.0",
        "symfony/expression-language": "^7.4",
        "symfony/flex": "^2.11",
        "symfony/form": "^7.0",
        "symfony/framework-bundle": "^7.0",
        "symfony/http-client": "^7.4",
        "symfony/monolog-bundle": "^3.1",
        "symfony/security-bundle": "^7.0",
        "symfony/serializer": "^7.0",
        "symfony/twig-bundle": "^7.0",
        "symfony/web-link": "^7.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "elife/api": "^2.31",
        "elife/api-validator": "dev-support-php-8.x",
        "justinrainbow/json-schema": "^5.2",
        "ml/json-ld": "^1.1",
        "phpspec/prophecy": "^1.7",
        "phpspec/prophecy-phpunit": "^v2.5.0",
        "phpunit/phpunit": "^12.5",
        "rawr/cross-data-providers": "^2.3",
        "squizlabs/php_codesniffer": "^3.5",
        "symfony/phpunit-bridge": "^7.4",
        "symfony/web-profiler-bundle": "^7.0"
    },
    "replace": {
        "paragonie/random_compat": "*",
        "symfony/polyfill-apcu": "*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-intl-icu": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php56": "*",
        "symfony/polyfill-php70": "*"
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "mindplay/composer-locator": true,
            "symfony/flex": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "google/apiclient-services": [
            "Sheets"
        ],
        "symfony": {
            "require": "7.4.*"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
